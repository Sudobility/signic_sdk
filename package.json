{
  "name": "@sudobility/signic_sdk",
  "version": "0.1.12",
  "description": "Node.js and browser SDK for Signic email - sign in with Ethereum or Solana, read and manage emails",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "build:watch": "tsc -p tsconfig.esm.json --watch",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "~9.39.4",
    "@types/node": "~24.12.0",
    "@typescript-eslint/eslint-plugin": "~8.58.0",
    "@typescript-eslint/parser": "~8.58.0",
    "@vitest/coverage-v8": "~4.1.2",
    "eslint": "~9.39.4",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.5",
    "globals": "~16.5.0",
    "prettier": "~3.8.1",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vitest": "~4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/signic_sdk.git"
  }
}
